# ============================================================
# Interactive visualization
#
# This macro is NOT executed automatically by BL4S_sim.
# Run it manually from the Idle> prompt when visualization
# is wanted.
# ============================================================

/det/setAbsorberMaterial G4_Al
/det/setAbsorberThickness 89.0 mm

/run/initialize

/vis/open OGL 600x600-0+0
/vis/drawVolume

/vis/viewer/set/viewpointThetaPhi 90. 0.

/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

/gun/particle e-
/gun/setNominalEnergy 2 GeV

/run/beamOn 5
