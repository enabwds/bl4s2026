# ============================================================
# Iron absorber thickness scan at 1, 2, and 4 GeV
#
# Iron X0 = 1.757 cm
# Thicknesses: 0.5, 1, 2, 3, 4, 5 X0
# ============================================================

/det/setAbsorberMaterial G4_Fe
/det/setAbsorberThickness 8.79 mm

/run/initialize

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/gun/particle e-

# ============================================================
# 1 GeV
# ============================================================

/gun/setNominalEnergy 1 GeV

/run/beamOn 2000

/det/setAbsorberThickness 17.57 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 35.14 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 52.71 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 70.28 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 87.85 mm
/det/update
/run/beamOn 2000

# ============================================================
# 2 GeV
# ============================================================

/gun/setNominalEnergy 2 GeV

/det/setAbsorberThickness 8.79 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 17.57 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 35.14 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 52.71 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 70.28 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 87.85 mm
/det/update
/run/beamOn 2000

# ============================================================
# 4 GeV
# ============================================================

/gun/setNominalEnergy 4 GeV

/det/setAbsorberThickness 8.79 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 17.57 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 35.14 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 52.71 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 70.28 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 87.85 mm
/det/update
/run/beamOn 2000
