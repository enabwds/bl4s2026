# ============================================================
# Blind-material validation run
#
# Material is intentionally kept as a separate test configuration.
# Composition should not be used by the ML/analysis pipeline until
# the blind prediction has been recorded.
#
# Brass: 70% Cu + 30% Zn by mass
# ============================================================

/det/setAbsorberMaterial Brass
/det/setAbsorberThickness 7.7 mm

/run/initialize

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/gun/particle e-

# ============================================================
# 1 GeV
# ============================================================

/gun/setNominalEnergy 1 GeV

/run/beamOn 2000

/det/setAbsorberThickness 15.4 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 30.8 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 46.2 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 61.6 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 77.0 mm
/det/update
/run/beamOn 2000

# ============================================================
# 2 GeV
# ============================================================

/gun/setNominalEnergy 2 GeV

/det/setAbsorberThickness 7.7 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 15.4 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 30.8 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 46.2 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 61.6 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 77.0 mm
/det/update
/run/beamOn 2000

# ============================================================
# 4 GeV
# ============================================================

/gun/setNominalEnergy 4 GeV

/det/setAbsorberThickness 7.7 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 15.4 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 30.8 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 46.2 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 61.6 mm
/det/update
/run/beamOn 2000

/det/setAbsorberThickness 77.0 mm
/det/update
/run/beamOn 2000

