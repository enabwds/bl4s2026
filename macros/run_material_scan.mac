# ============================================================
# Full material scan
#
# Current validation set:
#   Al, Fe, Cu, Pb
#
# Energies:
#   1, 2, 4 GeV
#
# Thicknesses:
#   0.5, 1, 2, 3, 4, 5 X0
#
# NOTE:
# Ti, Sn, and W will be added after the simulator passes
# the validation runs.
# ============================================================


# ============================================================
# ALUMINIUM
# X0 = 8.897 cm
# ============================================================

/det/setAbsorberMaterial G4_Al
/det/setAbsorberThickness 44.5 mm

/run/initialize

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/gun/particle e-

# 1 GeV
/gun/setNominalEnergy 1 GeV

/run/beamOn 2000

/det/setAbsorberThickness 89.0 mm
